# Copy to server/.env and fill in. (On Netlify, set these under Site configuration → Environment variables.)

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/todolist

# Secret used to sign login tokens — use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; a development fallback is used locally if omitted.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts (jsonwebtoken format: 7d, 12h, ...)
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS ("*" allows any; set your site URL in production)
CORS_ORIGIN=*

# Port for the local API server
PORT=4000
